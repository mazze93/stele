# stele-core — copy to .env and fill in. Never commit the filled copy.

# Postgres connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/stele?schema=public"

# Bearer token for every /api/* request. Required — the server returns 500 on
# all /api/* routes when this is unset rather than falling open.
# Generate one:  openssl rand -hex 32
API_SECRET=""

# Listener. Defaults are loopback:4000; only widen HOST deliberately, and put a
# reverse proxy in front of it if you do. Blanking either value falls back to
# the default rather than being passed through — an empty HOST would otherwise
# mean "bind every interface", which is the opposite of what blanking it looks
# like it should do.
HOST="127.0.0.1"
PORT="4000"
