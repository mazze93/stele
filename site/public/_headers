# Cloudflare Pages response headers for stele.mazzeleczzare.com.
# Pages applies every matching block; the most specific Cache-Control wins.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# Landing page CSP, report-only until Rocket Loader is switched off for this
# hostname (it rewrites scripts and would break under an enforced policy).
# Enforce by renaming the header once the console shows no reports.
/
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Font file names carry a content hash, so they never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps stable names (the README links to them), so revalidate weekly.
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/integrity-story.*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
